{
  "$schema": "../schemas/rule.schema.json",
  "id": "archive-org",
  "name": "Internet Archive 公共领域影片",
  "version": 1,
  "engine": "archive-org",
  "capabilities": ["search", "detail"],
  "request": {
    "search": {
      "url": "https://archive.org/advancedsearch.php?q=(title%3A%28{keyword}%29+OR+description%3A%28{keyword}%29)+AND+mediatype%3A%28movies%29&fl%5B%5D=identifier&fl%5B%5D=title&fl%5B%5D=year&fl%5B%5D=description&fl%5B%5D=mediatype&rows=24&page={page}&sort%5B%5D=downloads+desc&output=json",
      "method": "GET",
      "headers": {
        "Accept": "application/json"
      },
      "timeoutSeconds": 25
    },
    "detail": {
      "url": "https://archive.org/metadata/{id}",
      "method": "GET",
      "headers": {
        "Accept": "application/json"
      },
      "timeoutSeconds": 25
    }
  },
  "extract": {
    "search": {
      "list": "$.response.docs",
      "id": "$.identifier",
      "name": "$.title",
      "year": "$.year",
      "type": "$.mediatype",
      "picTemplate": "https://archive.org/services/img/{id}"
    },
    "detail": {
      "files": "$.files",
      "title": "$.metadata.title",
      "description": "$.metadata.description",
      "year": "$.metadata.year",
      "date": "$.metadata.date",
      "downloadBase": "https://archive.org/download/{id}/"
    }
  },
  "notes": "archive.org advancedsearch 搜片、metadata 取文件列表。播放器按扩展名挑视频文件，同组多清晰度只保留最佳一条；下载地址用 downloadBase + 文件名拼接。metadata 字段可能是数组，客户端取第一个非空值。"
}
