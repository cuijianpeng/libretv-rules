{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://libretv.dev/schemas/manifest.schema.json",
  "title": "LibreTV rule pack manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "version",
    "minAppVersion",
    "publishedAt",
    "files",
    "signature"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "minAppVersion": {
      "type": "string"
    },
    "publishedAt": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": true
      }
    },
    "signature": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
