{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://libretv.dev/schemas/rule.schema.json",
  "title": "LibreTV parser rule",
  "type": "object",
  "required": ["id", "name", "version", "engine", "capabilities"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "engine": {
      "enum": [
        "cms-json",
        "http-json",
        "html-regex",
        "archive-org",
        "m3u",
        "xmltv",
        "direct"
      ]
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["search", "detail", "play", "live", "epg"]
      }
    },
    "match": {
      "type": "object",
      "additionalProperties": true
    },
    "request": {
      "type": "object",
      "additionalProperties": true
    },
    "pagination": {
      "type": "object",
      "additionalProperties": true
    },
    "map": {
      "type": "object",
      "additionalProperties": true
    },
    "extract": {
      "type": "object",
      "additionalProperties": true
    },
    "detail": {
      "type": "object",
      "additionalProperties": true
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
