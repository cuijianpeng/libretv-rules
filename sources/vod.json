      "enabled": true,
      "tags": ["演示", "测试"],
      "note": "静态 JSON 测试源，仅用于验证搜索/详情/播放链路，不包含第三方内容。固定在 v4 tag，避免分支漂移。"
    },
    {
      "id": "open-movies",
      "name": "公开版权影片（Blender / W3C）",
      "type": "cms",
      "url": "https://raw.githubusercontent.com/cuijianpeng/libretv-rules/v5/fixtures/open-movies/cms.json",
      "rule": "cms-standard",
      "enabled": true,
      "tags": ["公开版权", "动画", "短片"],
