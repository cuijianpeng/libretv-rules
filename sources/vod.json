  "sources": [
    {
      "id": "demo-fixture",
      "name": "LibreTV 演示源（公开测试）",
      "type": "cms",
      "url": "https://ghproxy.net/https://raw.githubusercontent.com/cuijianpeng/libretv-rules/v9/fixtures/demo/cms.json",
      "rule": "cms-standard",
      "enabled": false,
      "tags": [
        "演示",
        "测试"
      ],
      "note": "已停用保留（相当于注释掉）：静态 JSON 测试源，仅用于验证链路。需要时在源管理里重新启用。"
    },
    {
      "id": "open-movies",
      "name": "公开版权影片（Blender / W3C）",
      "type": "cms",
      "url": "https://ghproxy.net/https://raw.githubusercontent.com/cuijianpeng/libretv-rules/v7/fixtures/open-movies/cms.json",
      "rule": "cms-standard",
      "enabled": true,
      "tags": [
        "公开版权",
        "动画",
        "短片"
      ],
      "note": "CC BY 授权的 Blender 开放电影与 W3C 测试片段，直连可播。静态目录，搜索会返回全部条目。"
    },
    {
      "id": "nasa-video",
      "name": "NASA 公开视频库",
      "type": "custom",
      "url": "https://images-api.nasa.gov",
      "rule": "nasa-video",
      "enabled": true,
      "tags": [
        "公开领域",
        "纪录片",
        "航天"
      ],
      "note": "NASA 官方公开视频库，可搜索航天纪录片和任务素材；MP4 直链，实测可连。"
    },
    {
      "id": "archive-org",
      "name": "Internet Archive 公共领域影片",
      "type": "custom",
      "url": "https://archive.org",
      "rule": "archive-org",
      "enabled": false,
      "tags": [
        "公开领域",
        "电影",
        "纪录片"
      ],
      "note": "按关键词搜索 archive.org 的公共领域影片。大陆网络通常无法直连（连接超时），需要代理；默认关闭。"
    },
    {
      "id": "example-cms",
      "name": "示例采集站",
      "type": "cms",
      "url": "https://example.com/api.php/provide/vod",
      "detail": "https://example.com",
      "rule": "cms-standard",
      "enabled": false,
      "tags": [
        "示例",
        "电影",
        "剧集"
      ],
      "note": "已停用保留（相当于注释掉）：占位示例，需要时替换成自己的源。"
    },
    {
      "id": "example-http-json",
      "name": "示例 JSON 接口",
      "type": "http-json",
      "url": "https://api.example.com/videos",
      "rule": "http-json",
      "enabled": false,
      "tags": [
        "示例"
      ],
      "note": "已停用保留（相当于注释掉）：展示 http-json 规则如何挂到源上。"
    }
