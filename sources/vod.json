    },
    {
      "id": "archive-org",
      "name": "Internet Archive 公共领域影片",
      "type": "custom",
      "url": "https://archive.org",
      "rule": "archive-org",
      "enabled": false,
      "tags": ["公开领域", "电影", "纪录片"],
